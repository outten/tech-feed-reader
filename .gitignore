.credentials
.env
tmp/
.cache/
*.log

# iOS app (ios/) — TechFeedReader.xcodeproj is generated by XcodeGen from
# ios/project.yml (see ios/README.md); build products are local-only.
ios/TechFeedReader.xcodeproj/
ios/build/
ios/DerivedData/
ios/*.xcuserstate
# Stale local SQLite files left over from before STUFF #47 (PG-only).
# Safe to delete; the app no longer reads them. Kept ignored here so
# they don't accidentally land in a commit before you do.
data/
coverage/

# OpenSpec / Claude Code slash-command + skill tooling — local workflow tooling
# that got committed unintentionally (was untracked at session start). Keep on
# disk; not repo content. Re-add specific files explicitly if a team wants them.
.claude/commands/
.claude/skills/
.github/prompts/
.github/skills/
